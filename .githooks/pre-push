#!/bin/sh
# This repository is public, so a push publishes. Refuse one that would
# publish anything on the maintainer's private list -- in a commit message, in
# a line a commit adds, or in a branch name -- or a comment that cites a record
# a reader cannot open. The list lives in the private vault, never in this
# tree; scripts/public_check.py says why.
#
# Without the vault there is no list, and only the comment check runs.
# Deliberate exception: git push --no-verify.

root=$(git rev-parse --show-toplevel) || exit 0
if [ -x "$root/.venv/bin/python" ]; then
	python="$root/.venv/bin/python"
else
	python=$(command -v python3) || exit 0
fi

exec "$python" "$root/scripts/public_check.py" --pre-push
